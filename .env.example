# PostgreSQL Database Configuration
# For local database:
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=thm_rent_a_car
PG_USER=postgres
PG_PASSWORD=admin

# For online database (Supabase, Neon, Railway, etc.):
# PG_HOST=your-host.supabase.co
# PG_PORT=5432
# PG_DATABASE=postgres
# PG_USER=postgres
# PG_PASSWORD=your-password

# Set to 'true' ONLY if you want to drop all tables and reset the database
# Leave empty or set to 'false' to preserve existing data (recommended for online databases)
DATABASE_RESET=false

# SMTP configuration for Gmail password reset and email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Application URL
APP_URL=http://localhost:3000
